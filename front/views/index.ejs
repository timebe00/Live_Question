<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>로그인</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/login.css">

    <script src="/js/jquery.min.js" ></script>
    <script src="/js/common/common.js"></script>
</head>

<body>
    <main class="login-page">
        <section class="login-box">
            <div class="card login-card">
                <h1 class="login-title">관리자 로그인</h1>
                <div class="field"><label>아이디</label><input id="user_id" required placeholder="아이디 입력"></div>
                <div class="field"><label>비밀번호</label><input id="user_pw" required type="password" placeholder="비밀번호 입력"></div>
                <button class="btn primary" id="send" >로그인</button>
            </div>
        </section>
    </main>
    <script>
      $(document).ready(function() {
        $("#send").on("click", async function() {
          let user_id = $("#user_id").val();
          let user_pw = $("#user_pw").val();

          await common.send("/login", "POST", { user_id, user_pw })
            .then((response) => response.json())
            .then((res) => {
              console.log("res : ", res);
            });
        })
      })
    </script>
</body>

</html>