<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>결과 상황판</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/present.css">
    <link rel="stylesheet" href="/css/results.css">

    <script src="/js/jquery.min.js"></script>
    <script src="/js/common/common.js"></script>
    <script src="/js/qrcode.min.js"></script>
</head>
<%
console.log("data : ", data)
console.log("data : ", data.question.items)
console.log("cnt : ", cnt)
%>
<body>
    <main class="page presentation">
        <div class="container">
            <header class="header">
                <div class="nav-actions">
                    <a class="btn ghost" href="/master">마스터 목록</a>
                    <button class="btn ghost" id="presentBtn">문제 화면</button>
                    <button class="btn ghost" id="toggleQrBtn">QR 가리기</button>
                    <button class="btn primary" id="qrBtn">QR 보기</button>
                    <button class="btn success" id="showAnswerBtn">정답보기</button>
                </div>
            </header>
            <div class="show-layout">
                <aside class="card qr-panel">
                    <div id="inlineQR"></div>
                </aside>
                <section class="card card-pad" id="resultArea">
                <div class="toolbar">
                    <div class="question-meta"><span class="badge blue" id="resultCount"><%=data.question.seq%> / <%=data.question_count%></span><span
                            class="badge green" id="resultTotal">총 <%=cnt.total_count%>명 참여</span></div>
                    <div class="button-row">
                        <button class="btn ghost" id="prevBtn">이전 문제</button>
                        <button class="btn ghost" id="nextBtn">다음 문제</button>
                    </div>
                </div>
                <h2 class="result-question" id="resultQuestion"><%=data.question.content%></h2>
                <div class="result-list" id="resultRows">
                    <%
                        let idx=0;
                        for(item of data.question.items){
                            ++idx;
                            let cntItem = cnt.items.find(function(c) { return c.item_no == item.item_no; });
                            let answerCnt = cntItem ? Number(cntItem.answer_cnt) || 0 : 0;
                            let pct = cnt.total_count ? Math.round(answerCnt / cnt.total_count * 100) : 0;
                    %>
                        <div class="result-row" data-item_no="<%=item.item_no%>">
                            <div class="result-no"><%=idx%></div>
                            <div>
                                <div class="result-label"><%=item.content%></div>
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:<%=pct%>%"></div>
                                </div>
                            </div>
                            <div class="result-stat">
                                <div class="count"><%=answerCnt%>명</div>
                                <div class="percent"><%=pct%>%</div>
                            </div>
                        </div>
                    <%}%>
                </div>
                <div class="answer-reveal" id="answerBox">
                    정답: <%=data.question.answer%>번 · <%=data.question.items[data.question.answer - 1].content%>
                </div>
            </section>
            </div>
        </div>
    </main>

    <div class="modal" id="qrModal">
        <div class="modal-panel qr-box">
            <div class="modal-head" style="width:100%">
                <h2>참여자 접속 QR</h2>
                <button class="close" onclick="common.closeModal('qrModal')">×</button>
            </div>
            <div id="setQR"></div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            let resultUrl = "/master/show_list/<%=data.question.master_no%>/<%=data.question.question_no%>/result";
            let showListWorker = new Worker("/js/showListWorker.js");

            function updateResultRows(cnt) {
                if (!cnt) {
                    return;
                }

                let totalCount = Number(cnt.total_count) || 0;
                $("#resultTotal").text("총 " + totalCount + "명 참여");

                if (!cnt.items) {
                    return;
                }

                cnt.items.forEach(function (item) {
                    let row = $(".result-row[data-item_no='" + item.item_no + "']");
                    let answerCnt = Number(item.answer_cnt) || 0;
                    let pct = totalCount ? Math.round(answerCnt / totalCount * 100) : 0;

                    row.find(".bar-fill").css("width", pct + "%");
                    row.find(".count").text(answerCnt + "명");
                    row.find(".percent").text(pct + "%");
                });
            }

            showListWorker.postMessage({ action: "start", url: resultUrl });

            showListWorker.onmessage = function (e) {
                if (e.data.success) {
                    updateResultRows(e.data.data);
                }
            };

            $(window).on("beforeunload", function () {
                showListWorker.postMessage({ action: "stop" });
                showListWorker.terminate();
            });

            $("#showAnswerBtn").on("click", function() {
                $("#answerBox").addClass("show");
            })

            $("#presentBtn").on("click", function() {
                location.href = "/master/show/<%=data.question.master_no%>/<%=data.question.question_no%>";
            })

            $("#prevBtn").on("click", function() {
                if(!"<%=data.prev_question_no%>") {
                    alert("처음 문제입니다.");
                    return;
                }

                location.href = "/master/show/<%=data.question.master_no%>/<%=data.prev_question_no%>"
            })

            $("#nextBtn").on("click", function() {
                if(!"<%=data.next_question_no%>") {
                    alert("마지막 문제입니다.");
                    return;
                }

                location.href = "/master/show/<%=data.question.master_no%>/<%=data.next_question_no%>"
            })

            $("#qrBtn").on("click", function() {
                $("#setQR").empty();
                common.openModal("qrModal");

                var link = location.origin + "/answer/<%=data.question.master_no%>/<%=data.question.question_no%>";
                QRCode.toDataURL(link, { width: 520 }, function (err, url) {
                    var img = document.createElement("img");
                    img.src = url;
                    document.getElementById("setQR").appendChild(img);
                });
            })

            var link = location.origin + "/answer/<%=data.question.master_no%>/<%=data.question.question_no%>";

            QRCode.toDataURL(link, { width: 540 }, function (err, url) {
                var img = document.createElement("img");
                img.src = url;
                img.alt = "참여 QR";
                document.getElementById("inlineQR").appendChild(img);
            });

            $("#toggleQrBtn").on("click", function() {
                var $layout = $(".show-layout");
                var hidden = $layout.toggleClass("qr-hidden").hasClass("qr-hidden");
                $(this).text(hidden ? "QR 보이기" : "QR 가리기");
            });
        })
    </script>
</body>

</html>