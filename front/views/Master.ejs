<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>문제 마스터</title>
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/master.css">

    <script src="/js/jquery.min.js" ></script>
    <script src="/js/common/common.js"></script>
</head>

<body>
    <main class="page">
        <div class="container">
            <header class="header">
                <div>
                    <h1 class="title">문제 관리 페이지</h1>
                    <p class="subtitle">행사, 강의, 세션 단위로 문제 묶음을 만들고 관리합니다.</p>
                </div>
                <div class="nav-actions"><button class="btn primary" id="newMasterBtn">문제 마스터 생성</button>
                    <a class="btn ghost" href="/logout">로그아웃</a></div>
            </header>
            <section class="card">
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>제목</th>
                                <th>문제 수</th>
                                <th>생성일</th>
                                <th>관리</th>
                            </tr>
                        </thead>
                        <tbody id="masterRows">
                            <% if (masters && masters.length > 0) { %>
                              <% masters.forEach(function(master) { %>
                              <tr class="clickable" data-master-no="<%= master.master_no %>">
                                <td><strong><%= master.title %></strong></td>
                                <td><span class="badge blue"><%= master.question_count %>개 문제</span></td>
                                <td><%= master.reg_date %></td>
                                <td><div class="row-actions">
                                  <button class="btn ghost createQuestionBtn" data-master-no="<%= master.master_no %>">문제 생성</button>
                                  <button class="btn danger resetAnswerBtn" data-master-no="<%= master.master_no %>">답안 초기화</button>
                                  <button class="btn ghost editMasterBtn" data-master-no="<%= master.master_no %>">수정</button>
                                  <button class="btn danger deleteMasterBtn" data-master-no="<%= master.master_no %>">삭제</button>
                                </div></td>
                              </tr>
                              <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
    <div class="modal" id="masterModal">
        <div class="modal-panel">
            <div class="modal-head">
                <h2>문제 마스터</h2><button class="close" onclick="common.closeModal('masterModal')">×</button>
            </div>
              <input type="hidden" id="masterNo">
              <div class="field">
                <label>제목</label>
                <input id="masterTitle" required placeholder="예: 제22차 기능검사 워크샵">
              </div>
              <div class="button-row">
                <button class="btn primary" id="saveMasterBtn">저장</button>
                <button class="btn ghost" type="button" onclick="common.closeModal('masterModal')">취소</button>
            </div>
        </div>
    </div>
    <script>
      $(document).ready(function() {
        $(document).on("click", "tr.clickable", function(e) {
          if ($(e.target).closest(".row-actions").length) {
            return;
          }
          location.href = "/master/show/" + $(this).data("master-no") + "/0";
        });

        $(document).on("click", ".createQuestionBtn", function() {
          location.href = "/master/" + $(this).data("master-no");
        })

        $("#newMasterBtn").on("click", function() {
          $("#masterNo").val("");
          $("#masterTitle").val("");
          common.openModal('masterModal');
        });

        $(document).on("click", ".editMasterBtn", function() {
          let masterNo = $(this).data("master-no");
          let title = $(this).closest("tr").find("td:first strong").text();
          $("#masterNo").val(masterNo);
          $("#masterTitle").val(title);
          common.openModal('masterModal');
        });

        $(document).on("click", ".deleteMasterBtn", async function() {
          if (!confirm("문제 마스터와 하위 문제를 삭제할까요?")) {
            return;
          }

          let masterNo = $(this).data("master-no");
          await common.send("/master", "DELETE", { master_no: masterNo })
            .then((response) => response.json())
            .then((res) => {
              if (res.data && res.data.success) {
                location.href = "/master";
              }
            });
        });

        $(document).on("click", ".resetAnswerBtn", async function() {
          if (!confirm("해당 문제 마스터의 모든 답안을 초기화할까요?")) {
            return;
          }

          let masterNo = $(this).data("master-no");
          await common.send("/master/reset-answers", "POST", { master_no: masterNo })
            .then((response) => response.json())
            .then((res) => {
              if (res.data && res.data.success) {
                alert("답안이 초기화되었습니다.");
              }
            });
        });

        $("#saveMasterBtn").on("click", async function() {
          let masterNo = $("#masterNo").val();
          let title = $("#masterTitle").val().trim();
          if (!title) {
            alert("제목을 입력해주세요.");
            return;
          }

          let method = masterNo ? "PUT" : "POST";
          let params = masterNo ? { master_no: masterNo, title } : { title };

          await common.send("/master", method, params)
            .then((response) => response.json())
            .then((res) => {
              if (res.data && res.data.success) {
                location.href = "/master";
              }
            });
        });
      });
    </script>
</body>

</html>